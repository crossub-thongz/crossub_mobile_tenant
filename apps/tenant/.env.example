# Browser-side API base. '/api' is proxied by app/api/[...path]/route.ts (same-origin cookies).
NEXT_PUBLIC_API_URL=/api

# Server-side proxy target — crossub_web Nest API (apps/api).
# Local: http://localhost:3001  (pnpm dev:api in crossub_web)
# Render: https://your-crossub-api.onrender.com  (no trailing slash)
API_INTERNAL_URL=http://localhost:3001

# Optional — links in UI to related CROSSUB surfaces
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_PORTAL_URL=http://localhost:3002

# Demo mode: mock tenancy (12 River Lane, repairs, etc.) for API logins like system@crossub.com.au
# NEXT_PUBLIC_* is baked in at build time; TENANT_* can be changed on the server without rebuild.
NEXT_PUBLIC_USE_DEMO_DATA=true
TENANT_USE_DEMO_DATA=true
