# Browser-side API base. '/api' is proxied by app/api/[...path]/route.ts (same-origin cookies).
NEXT_PUBLIC_API_URL=/api

# MUST match crossub_web/apps/web/.env.local API_INTERNAL_URL exactly.
# Local dev: agent portal + tenant app both use http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Note: admin (localhost:3000) and tenant (localhost:3003) share the csb_at cookie on the
# same host. The tenant app rejects non-TENANT roles; use separate hostnames if you need
# both portals signed in at once (e.g. web.localhost vs tenant.localhost).
# Staging:
# API_INTERNAL_URL=https://crossub-api-staging.onrender.com

# Optional — links in UI to related CROSSUB surfaces
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_PORTAL_URL=http://localhost:3002

# Demo mode (opt-in): mock signed-in tenant lifecycle when API is unavailable.
# Guest property listings always load from the API only.
# NEXT_PUBLIC_USE_DEMO_DATA=true

# After deploying crossub_web API to staging, seed active leasing cycles so rent shows
# and guest applications route to agent review:
#   cd crossub_web && pnpm --filter @crossub/api seed:public-listings
